# Copy to ".env" in the repo root (never commit .env):
#   cp .env.example .env
# Docker Compose reads these automatically when present.

# --- PostgreSQL (both databases) ---
POSTGRES_USER=insurance
POSTGRES_PASSWORD=changeme

# Host ports (container internal DB port stays 5432)
POSTGRES_POLICY_PORT=5432
POSTGRES_PAYMENT_PORT=5433

# --- Kafka (KRaft) ---
KAFKA_PUBLIC_PORT=9092

# --- Redis / Zipkin ---
REDIS_PORT=6379
ZIPKIN_PORT=9411

# --- Spring Boot services ---
POLICY_SERVICE_PORT=8081
PAYMENT_SERVICE_PORT=8082

# --- GHCR images (match .github/workflows/deploy.yml; owner is lowercased in CI) ---
GHCR_REGISTRY=ghcr.io
GHCR_IMAGE_OWNER=lalifefer
SERVICE_IMAGE_TAG=latest
